# Carga de libreria
if(!require(readxl)) install.packages("readxl")
library(readxl)
#CARGA DE ARCHIVO
archivo<-file.choose()
datos<-read_excel(archivo)
#Variable: Tiempo de estudio
tabla_tiempoEstudio<- table(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`)
#--------Calculo de datos
cant_filas<- length(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`)#obtengo la cantidad de datos
rango <- range(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`)# range busca el min y el maximo
k <- ceiling(1 + 3.322 * log10(cant_filas))# Regla de Sturges
amplitud <- ceiling((rango[2] - rango[1]) / k)
#--------------
breaks <- seq(floor(rango[1]), ceiling(rango[2]) + amplitud, by = amplitud)
clases <- cut(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`, breaks = breaks, right = FALSE)
tabla_tiempo<-table(clases)
f_acum<-cumsum(tabla_tiempo)
f_rel<-prop.table(tabla_tiempo)
f_rel_acum<-cumsum(f_rel)
#Armado de tabla
tabla_estudio_en_hs <- data.frame(
Intervalo = levels(clases),
Frecuencia = as.vector(tabla_tiempo),
Frec_acumulada = as.vector(f_acum),
Frec_relativa = round(as.vector(f_rel),4),
Frec_rel_acum = round(as.vector(f_rel_acum),4)
)
#imprimo tabla_estudio_en_hs
print(tabla_estudio_en_hs, row.names = FALSE)
#FIN VARIABLE TIEMPO DE ESTUDIO EN HS
#INICIO VARIABLE SATISFACCION CON CARRERA
tabla_satisfaccion<- table(datos$`SATISFACCIÓN CON LA CARRERA`)
f_rel<- prop.table(tabla_satisfaccion)
#----Armado de tabla
tabla_satisf_carrera<- data.frame(
Satisfaccion = names(tabla_satisfaccion),
Frecuencia = as.vector(tabla_satisfaccion),
Frec_acum = cumsum(tabla_satisfaccion),
Frec_Rel = round(as.vector(f_rel),4),
Frec_rel_acum = round(cumsum(f_rel),4)
)
#Muestra tabla
print(tabla_satisf_carrera, row.names=FALSE)
